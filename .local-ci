#!/usr/bin/env bash
# The checks every PR must pass, run on this machine by `local-ci` (claude-toolkit) in
# place of GitHub Actions. Run it directly to check without posting a status.
#
# Everywhere: format, then lint, test and build the Linux version, and lint the Windows one.
# On a Windows PC (WSL) also: the MSVC build releases use, its tests and size budget, and the
# end-to-end smoke test (an install -> uninstall round trip) in a throwaway Windows Sandbox VM
# via `win-sandbox` (claude-toolkit): never on this machine, where SLC may be installed.
set -euo pipefail
cd "$(dirname "$0")"
max_exe_bytes=1048576

step() { echo; echo "== $*"; }
check_size() {
	local size; size=$(stat -c %s "$1")
	echo "$(basename "$1"): $size bytes"
	if [ "$size" -gt "$max_exe_bytes" ]; then
		echo "$(basename "$1") exceeds the size budget ($max_exe_bytes bytes)" >&2
		exit 1
	fi
}

windows_pc=false
command -v cmd.exe >/dev/null && windows_pc=true

if ! $windows_pc; then
	export PATH="$HOME/.cargo/bin:$PATH"
	# Outside the project folder, and shared between worktrees.
	export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$HOME/.cache/slc-target}"
	linux=x86_64-unknown-linux-musl

	step "format";         cargo fmt --all -- --check
	step "clippy (Linux)"; cargo clippy --target $linux --all-targets -- -D warnings
	step "test (Linux)";   cargo test --target $linux
	step "clippy (Windows, type-check only)"
	SLC_SKIP_RESOURCES=1 cargo clippy --target x86_64-pc-windows-gnu --all-targets -- -D warnings
	step "release build (Linux)"; cargo build --release --target $linux
	bin="$CARGO_TARGET_DIR/$linux/release/slc"
	step "size budget"; check_size "$bin"
	step "version";     "$bin" --version
	echo
	echo "NOT RUN (needs a Windows PC): Windows tests, MSVC release build, smoke test."
	exit 0
fi

cargo=scripts/cargo-msvc.sh
step "format";        $cargo fmt --all -- --check
step "clippy";        $cargo clippy --all-targets -- -D warnings
step "test";          $cargo test
step "release build"; $cargo build --release

win_home=$(wslpath "$(cmd.exe /c 'echo %USERPROFILE%' 2>/dev/null | tr -d '\r')")
exe="$win_home/.slc-tools/target-msvc/release/slc.exe"
step "size budget"; check_size "$exe"
step "version";     "$exe" --version

step "smoke test (Windows Sandbox)"
stage=$(mktemp -d)
trap 'rm -rf "$stage"' EXIT
cp "$exe" scripts/smoke.ps1 "$stage/"
# win-sandbox runs this with $ErrorActionPreference = 'Stop', so a throw fails the run.
printf '%s\r\n' '& "$PSScriptRoot\smoke.ps1" -Exe "$PSScriptRoot\slc.exe"' >"$stage/run.ps1"
win-sandbox "$stage" run.ps1 900
